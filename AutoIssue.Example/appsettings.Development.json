{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "GitHubFeedback": {
        "Issues": {
            "Owner": "your-org-or-user",
            "Repository": "your-issues-repo",
            "Token": "",
            "FeedbackLabel": "feedback",
            "AdditionalLabels": [ "from-website" ]
        },
        "Attachments": {
            "Repository": "your-files-repo",
            "Branch": "main",
            "Folder": "example-feedback",
            "AllowedFileTypes": [ ".png", ".jpg", ".jpeg", ".gif", ".pdf", ".txt", ".nef" ] //nef is not supported by default
        }
    }
}