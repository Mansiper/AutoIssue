@page "/issue"
@rendermode InteractiveServer
@using AutoIssue.Models
@using AutoIssue.Services
@inject IGitHubFeedbackService FeedbackService

<PageTitle>Issue by Number</PageTitle>

<h1>Get Issue by Number</h1>

<p>Look up a single issue by its GitHub issue number.</p>

<div class="card shadow-sm mb-4" style="max-width: 360px;">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label fw-semibold">Issue number</label>
            <input class="form-control" type="number" min="1" @bind="issueNumber" />
        </div>

        <button class="btn btn-primary" @onclick="Load" disabled="@(loading || issueNumber < 1)">
            @(loading ? "Loading…" : "Fetch Issue")
        </button>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger"><strong>Error:</strong> @error</div>
}

@if (searched && error is null)
{
    @if (issue is null)
    {
        <div class="alert alert-warning">Issue #@issueNumber not found (or it is a pull request).</div>
    }
    else
    {
        <div class="card shadow-sm" style="max-width: 640px;">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <a href="@issue.Url" target="_blank" rel="noopener noreferrer">#@issue.Number</a>
                    — @issue.Title
                </span>
                <span class="badge @(issue.State == "open" ? "bg-success" : "bg-secondary")">
                    @issue.State
                </span>
            </div>
            <div class="card-body">
                @if (issue.Contact is not null)
                {
                    <p class="mb-1"><strong>Contact:</strong> @issue.Contact</p>
                }
                @if (issue.Labels.Count > 0)
                {
                    <p class="mb-1">
                        <strong>Labels:</strong>
                        @foreach (var label in issue.Labels)
                        {
                            <span class="badge bg-primary me-1">@label</span>
                        }
                    </p>
                }
                <p class="mb-1"><strong>Created:</strong> @issue.CreatedAt.LocalDateTime.ToString("g")</p>
                @if (issue.ClosedAt is not null)
                {
                    <p class="mb-1">
                        <strong>Closed:</strong> @issue.ClosedAt.Value.LocalDateTime.ToString("g")
                        @(issue.StateReason is not null ? $"({issue.StateReason})" : "")
                    </p>
                }
                @if (issue.Attachments.Count > 0)
                {
                    <p class="mb-1"><strong>Attachments:</strong></p>
                    <ul class="mb-0">
                        @foreach (var att in issue.Attachments)
                        {
                            <li><a href="@att.Url" target="_blank" rel="noopener noreferrer">@att.Name</a></li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
}

@code {
    private int issueNumber = 1;
    private bool loading;
    private bool searched;
    private string? error;
    private FeedbackIssue? issue;

    private async Task Load()
    {
        loading = true;
        error = null;
        searched = false;
        issue = null;

        try
        {
            issue = await FeedbackService.GetIssueByNumber(issueNumber);
            searched = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
