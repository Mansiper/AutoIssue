@page "/issues-by-contact"
@rendermode InteractiveServer
@using AutoIssue.Enums
@using AutoIssue.Models
@using AutoIssue.Services
@inject IGitHubFeedbackService FeedbackService

<PageTitle>Issues by Contact</PageTitle>

<h1>Issues by Contact</h1>

<p>Find all feedback issues submitted by a specific contact (case-insensitive).</p>

<div class="card shadow-sm mb-4" style="max-width: 480px;">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label fw-semibold">Contact</label>
            <input class="form-control" @bind="contact" placeholder="E-mail, phone, or username" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">State</label>
            <select class="form-select" @bind="stateFilter">
                <option value="@IssueStateFilter.All">All</option>
                <option value="@IssueStateFilter.Open">Open</option>
                <option value="@IssueStateFilter.Closed">Closed</option>
            </select>
        </div>

        <button class="btn btn-primary" @onclick="Search"
                disabled="@(loading || string.IsNullOrWhiteSpace(contact))">
            @(loading ? "Searching…" : "Search")
        </button>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger"><strong>Error:</strong> @error</div>
}

@if (issues is not null)
{
    <p class="text-muted">@issues.Count issue(s) found for <strong>@searchedContact</strong>.</p>

    @if (issues.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>State</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var issue in issues)
                    {
                        <tr>
                            <td>
                                <a href="@issue.Url" target="_blank" rel="noopener noreferrer">
                                    #@issue.Number
                                </a>
                            </td>
                            <td>@issue.Title</td>
                            <td>
                                <span class="badge @(issue.State == "open" ? "bg-success" : "bg-secondary")">
                                    @issue.State
                                </span>
                            </td>
                            <td>@issue.CreatedAt.LocalDateTime.ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private string contact = string.Empty;
    private IssueStateFilter stateFilter = IssueStateFilter.All;
    private bool loading;
    private string? error;
    private string? searchedContact;
    private IReadOnlyList<FeedbackIssue>? issues;

    private async Task Search()
    {
        loading = true;
        error = null;
        issues = null;
        searchedContact = contact.Trim();

        try
        {
            issues = await FeedbackService.GetIssuesByContact(searchedContact, stateFilter);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
