@page "/issues"
@rendermode InteractiveServer
@using AutoIssue.Enums
@using AutoIssue.Models
@using AutoIssue.Services
@inject IGitHubFeedbackService FeedbackService

<PageTitle>Issues</PageTitle>

<h1>List Issues</h1>

<p>Retrieve issues from the configured repository with optional filters.</p>

<div class="card shadow-sm mb-4" style="max-width: 480px;">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label fw-semibold">State</label>
            <select class="form-select" @bind="stateFilter">
                <option value="@IssueStateFilter.All">All</option>
                <option value="@IssueStateFilter.Open">Open</option>
                <option value="@IssueStateFilter.Closed">Closed</option>
            </select>
        </div>

        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" id="feedbackOnly" @bind="feedbackOnly" />
            <label class="form-check-label" for="feedbackOnly">Feedback label only</label>
        </div>

        <button class="btn btn-primary" @onclick="Load" disabled="@loading">
            @(loading ? "Loading…" : "Load Issues")
        </button>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger"><strong>Error:</strong> @error</div>
}

@if (issues is not null)
{
    <p class="text-muted">@issues.Count issue(s) found.</p>

    @if (issues.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>State</th>
                        <th>Contact</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var issue in issues)
                    {
                        <tr>
                            <td>
                                <a href="@issue.Url" target="_blank" rel="noopener noreferrer">
                                    #@issue.Number
                                </a>
                            </td>
                            <td>@issue.Title</td>
                            <td>
                                <span class="badge @(issue.State == "open" ? "bg-success" : "bg-secondary")">
                                    @issue.State
                                </span>
                            </td>
                            <td>@(issue.Contact ?? "—")</td>
                            <td>@issue.CreatedAt.LocalDateTime.ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private IssueStateFilter stateFilter = IssueStateFilter.All;
    private bool feedbackOnly = true;
    private bool loading;
    private string? error;
    private IReadOnlyList<FeedbackIssue>? issues;

    private async Task Load()
    {
        loading = true;
        error = null;
        issues = null;

        try
        {
            issues = await FeedbackService.GetIssues(stateFilter, feedbackOnly);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
